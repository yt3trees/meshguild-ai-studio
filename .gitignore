
## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015 cache/options directory
.vs/

# Visual Studio 2017 cache/options directory
.vs/

# Visual Studio 2019 cache/options directory
.vs/

# Visual Studio 2022 cache/options directory
.vs/

# Rider files
.idea/

# Mac files
.DS_Store

# Gemini CLI specific
.gemini/

# Local application settings
**/appsettings.Development.json

# Local secrets, logs, and temporary files
.env*
*.log
*.tmp
*.swp
Thumbs.db

# Claude Code local runtime state
.claude/scheduled_tasks.lock

# Node.js and Playwright E2E artifacts
node_modules/
dist/
build/
test-results/
playwright-report/
e2e-runtime/
*.db
*.db-shm
*.db-wal

# Don't commit the solution file if it's auto-generated, but track if it's checked in.
*.sln

# Jekyll (manual/ GitHub Pages site)
manual/_site/
manual/.jekyll-cache/
manual/.jekyll-metadata
manual/.bundle/
manual/vendor/

specs/
.specify/