    private EditorSnapshot? lastCommitted;

    private string newMetricName = string.Empty;
    private double newMetricTarget;
    private string newMetricDirection = "gte";

    private GraphNode? SelectedNode => nodes.FirstOrDefault(node => node.Id == selectedNodeId);

