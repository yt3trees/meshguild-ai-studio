    private void LoadGraph(GraphDefinition? graph)
    {
        original = graph;
        if (graph is null)
        {
            return;
        }
        name = graph.Name;
        displayName = graph.DisplayName;
        description = graph.Description;
        defaults = graph.Defaults ?? new GraphDefaults();
        nodes = graph.Nodes.ToList();
        edges = graph.Edges.ToList();
        layout = new Dictionary<string, (double X, double Y)>(graph.Layout, StringComparer.Ordinal);
        subgraphs = new Dictionary<string, SubgraphDefinition>(graph.Subgraphs, StringComparer.Ordinal);
        editingSubgraphId = null;
        selectedNodeId = null;
        isDirty = false;
        diagnostics = null;
        savedMessage = null;
        undoStack.Clear();
        lastCommitted = CaptureSnapshot();
        Refresh();
    }

    /// <summary>
    /// 保存・検証・YAML 表示に使う「ルート」グラフ全体。サブグラフ編集中でも中身は常にルートの nodes/edges/layout で、
    /// 編集中のサブグラフだけ subgraphs 辞書の該当エントリを最新の内容に差し替える。
    /// </summary>
    private GraphDefinition WorkingGraph => (original ?? new GraphDefinition { Name = name, Nodes = [], Edges = [] }) with
    {
        Name = name,
        DisplayName = displayName,
        Description = description,
        Defaults = HasDefaults ? defaults : null,
        Nodes = editingSubgraphId is null ? nodes : rootNodes,
        Edges = editingSubgraphId is null ? edges : rootEdges,
        Layout = editingSubgraphId is null ? layout : rootLayout,
        Subgraphs = editingSubgraphId is null
            ? subgraphs
            : new Dictionary<string, SubgraphDefinition>(subgraphs, StringComparer.Ordinal)
            {
                [editingSubgraphId] = new SubgraphDefinition { Nodes = nodes, Edges = edges },
            },
    };

    /// <summary>キャンバス描画・ナラーションに使う「今編集している範囲」のグラフ。ルート編集中は WorkingGraph と同じ、
    /// サブグラフ編集中はそのサブグラフの中身 (nodes/edges/layout) を映す。</summary>
    private GraphDefinition CanvasGraph => WorkingGraph with
    {
        Nodes = nodes,
        Edges = edges,
        Layout = layout,
    };

    private bool HasDefaults => !string.IsNullOrWhiteSpace(defaults.Team)
        || defaults.BudgetCostLimitUsd.HasValue
        || defaults.BudgetTimeLimitSeconds.HasValue;

    /// <summary>
    /// 直前の確定状態 (lastCommitted、= 今回の変更が始まる前の状態) を Undo スタックに積んでから、
    /// 変更後の状態を新しい確定状態にする。呼び出し側は先にフィールドを書き換えてから呼ぶ。
    /// </summary>
    private void MarkDirty()
    {
        if (lastCommitted is not null)
        {
            undoStack.Add(lastCommitted);
            if (undoStack.Count > 50)
            {
                undoStack.RemoveAt(0);
            }
        }
        lastCommitted = CaptureSnapshot();
        isDirty = true;
        savedMessage = null;
        Refresh();
    }

    private EditorSnapshot CaptureSnapshot() => new(
        nodes.ToList(),
        edges.ToList(),
        new Dictionary<string, (double X, double Y)>(layout, StringComparer.Ordinal),
        defaults,
        name,
        displayName,
        description,
        new Dictionary<string, SubgraphDefinition>(subgraphs, StringComparer.Ordinal));

    private void RestoreSnapshot(EditorSnapshot snapshot)
    {
        nodes = snapshot.Nodes.ToList();
        edges = snapshot.Edges.ToList();
        layout = new Dictionary<string, (double X, double Y)>(snapshot.Layout, StringComparer.Ordinal);
        defaults = snapshot.Defaults;
        name = snapshot.Name;
        displayName = snapshot.DisplayName;
        description = snapshot.Description;
        subgraphs = new Dictionary<string, SubgraphDefinition>(snapshot.Subgraphs, StringComparer.Ordinal);
    }

    /// <summary>直前の変更を取り消す。スコープ (ルート/サブグラフ) をまたいだ undo は扱わない — 切り替え時にスタックを空にしている。</summary>
    private void Undo()
    {
        if (undoStack.Count == 0)
        {
            return;
        }
        var snapshot = undoStack[^1];
        undoStack.RemoveAt(undoStack.Count - 1);
        RestoreSnapshot(snapshot);
        lastCommitted = snapshot;
        selectedNodeId = null;
        selectedEdgeId = null;
        isDirty = true;
        savedMessage = null;
        Refresh();
    }

    /// <summary>JS から Ctrl+Z で呼ばれる。</summary>
    [JSInvokable]
    public void OnUndoShortcut()
