@page "/graphs"
@page "/graphs/{GraphName}"
@using WorkAgents.Core.Authoring
@using WorkAgents.Core.Graphs
@inject DefinitionAuthoringService Authoring
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>MeshGuild AI Studio | Graph Studio</PageTitle>

@if (GraphName is null)
{
    <div class="wa-scroll-page">
        <div class="wa-inner">
            <div class="wa-head">
                <div><h1>Graph Studio</h1><p>グラフを選択すると詳細と編集画面が開きます</p></div>
                <div><a class="wa-btn wa-btn-primary wa-btn-sm" href="definitions/new?kind=graph">New graph</a></div>
            </div>
            @if (Authoring.Graphs.Count == 0)
            {
                <div class="wa-panel">
                    <div class="wa-empty">
                        グラフ定義はまだありません。
                        <a class="wa-btn wa-btn-primary wa-btn-sm" href="definitions/new?kind=graph">テンプレートから作る</a>
                    </div>
                </div>
            }
            else
            {
                <div class="wa-card-grid" data-pw="graph-list">
                    @foreach (var graph in Authoring.Graphs)
                    {
                        <a class="wa-panel wa-link-card" href="graphs/@graph.Name" data-pw="graph-list-item">
                            <div class="wa-link-card-title"><span>@graph.Name</span><span class="wa-tag">v@(graph.Version)</span></div>
                            <div class="wa-link-card-meta">@DefinitionNarrator.Headline(graph)</div>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
}
else if (original is null)
{
    <div class="wa-scroll-page">
        <div class="wa-inner">
            <div class="wa-head"><div><h1>Graph Studio</h1><p><a class="wa-back-link" href="graphs">← 一覧へ戻る</a></p></div></div>
            <div class="wa-panel"><div class="wa-empty">グラフ「@GraphName」は見つかりませんでした。</div></div>
        </div>
    </div>
}
else
{
<div class="wa-graph-wrap">
    @if (toastMessage is not null)
    {
        <div class="wa-toast wa-toast-@toastKind" data-pw="graph-toast">@toastMessage</div>
    }
    <main class="wa-graph-main">
        <div class="wa-graph-toolbar">
            <a class="wa-back-link" href="graphs">← 一覧</a>
            <h1 class="wa-graph-title">Graph Studio</h1>
            <span class="wa-tag wa-tag-accent">@original.Name</span>
            <span class="wa-tag">v@(original.Version)</span>
            @if (editingSubgraphId is not null)
            {
                <button class="wa-btn wa-btn-sm" type="button" @onclick="ExitSubgraph" data-pw="graph-exit-subgraph">← @original.Name に戻る</button>
                <span class="wa-tag wa-tag-purple" data-pw="graph-subgraph-badge">サブグラフ: @editingSubgraphId</span>
            }
            @if (isDirty)
            {
                <span class="wa-tag wa-tag-warn" data-pw="graph-dirty">未保存の変更</span>
            }
            <span class="wa-toolbar-spacer"></span>
            <button class="wa-btn wa-btn-sm" type="button" @onclick="AddNode" data-pw="graph-add-node">+ ノード</button>
            <button class="wa-btn wa-btn-sm" type="button" @onclick="Validate" data-pw="graph-validate">検証</button>
            <button class="wa-btn wa-btn-sm" type="button" @onclick="@(() => SetTab("yaml"))" data-pw="graph-show-yaml">YAML で表示</button>
            <button class="wa-btn wa-btn-primary wa-btn-sm" type="button" @onclick="SaveAsync" disabled="@(!isDirty || isSaving)" data-pw="graph-save">
                @(isSaving ? "保存中…" : "保存")
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(savedMessage))
        {
            <div class="wa-note wa-note-accent" data-pw="graph-saved">@savedMessage</div>
        }

        <div class="wa-graph-canvas" data-pw="graph-canvas" @ref="canvasScrollRef">
            <div class="wa-canvas-tools">
                <div class="wa-canvas-tools-inner">
                    <button class="wa-btn wa-btn-sm" type="button" @onclick="Undo" disabled="@(undoStack.Count == 0)" data-pw="graph-undo" title="元に戻す (Ctrl+Z)">↶ 戻す</button>
                    <button class="wa-btn wa-btn-sm" type="button" @onclick="ClearSelection" disabled="@(selectedNodeId is null)" data-pw="graph-show-all" title="選択を解除してすべてのノードを明るく表示する">すべて表示</button>
                </div>
            </div>
            @{ var edgeGeometry = ComputeEdgeGeometry(); }
            <div class="wa-canvas-inner" @ref="canvasInnerRef" @onclick="ClearSelection" style="width:@(canvasSize.Width)px;height:@(canvasSize.Height)px">
                <svg class="wa-graph-edges" viewBox="0 0 @(canvasSize.Width) @(canvasSize.Height)" style="width:@(canvasSize.Width)px;height:@(canvasSize.Height)px">
                    <defs>
                        <marker id="wa-arrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse">
                            <path d="M0,0 L10,5 L0,10 z" fill="#5a5a66" />
                        </marker>
                        <marker id="wa-arrow-accent" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse">
                            <path d="M0,0 L10,5 L0,10 z" fill="#5e8bff" />
                        </marker>
                        <marker id="wa-arrow-loop" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse">
                            <path d="M0,0 L10,5 L0,10 z" fill="#4a4256" />
                        </marker>
                        <marker id="wa-arrow-loop-accent" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse">
                            <path d="M0,0 L10,5 L0,10 z" fill="#b48ee0" />
                        </marker>
                    </defs>
                    @foreach (var geo in edgeGeometry)
                    {
                        var edge = geo.Edge;
                        var isRelated = selectedNodeId is not null && (edge.From == selectedNodeId || edge.To == selectedNodeId);
                        var isDimmed = selectedNodeId is not null && !isRelated;
                        var isEmphasized = isRelated || selectedEdgeId == edge.Id;
                        var cssClass = $"{(edge.LoopBack ? "wa-edge-loop" : "wa-edge")} {(selectedEdgeId == edge.Id ? "selected" : null)} {(isRelated ? "wa-edge-related" : null)} {(isDimmed ? "wa-edge-dim" : null)}";
                        var markerId = edge.LoopBack
                            ? (isEmphasized ? "wa-arrow-loop-accent" : "wa-arrow-loop")
                            : (isEmphasized ? "wa-arrow-accent" : "wa-arrow");
                        @if (geo.PathD is not null)
                        {
                            <path d="@geo.PathD" fill="none" marker-end="url(#@markerId)" class="@cssClass" />
                            <path d="@geo.PathD" fill="none" class="wa-edge-hit"
                                  @onclick="() => SelectEdge(edge.Id)" @onclick:stopPropagation="true" data-pw="graph-edge-hit" />
                        }
                        else
                        {
                            <line x1="@geo.X1" y1="@geo.Y1" x2="@geo.X2" y2="@geo.Y2" marker-end="url(#@markerId)" class="@cssClass" />
                            <line x1="@geo.X1" y1="@geo.Y1" x2="@geo.X2" y2="@geo.Y2" class="wa-edge-hit"
                                  @onclick="() => SelectEdge(edge.Id)" @onclick:stopPropagation="true" data-pw="graph-edge-hit" />
                        }
                    }
                    <line @ref="edgePreviewRef" class="wa-edge-preview" x1="0" y1="0" x2="0" y2="0" />
                </svg>
                @foreach (var item in nodes.Select((node, index) => (node, index)))
                {
                    var position = PositionOf(item.node.Id);
                    var isSelected = selectedNodeId == item.node.Id;
                    var isRelated = !isSelected && selectedNodeId is not null && ConnectedNodeIds.Contains(item.node.Id);
                    var isDimmed = selectedNodeId is not null && !isSelected && !isRelated;
                    <button type="button"
                            class="wa-graph-node wa-node-@item.node.Kind.ToString().ToLowerInvariant() @(isSelected ? "selected" : null) @(isRelated ? "wa-node-related" : null) @(isDimmed ? "wa-node-dim" : null) @(HasProblem(item.node.Id) ? "wa-node-problem" : null)"
                            style="left:@(position.X)px;top:@(position.Y)px"
                            @onclick="() => SelectNode(item.node.Id)" @onclick:stopPropagation="true"
                            data-pw="graph-node" data-node-id="@item.node.Id">
                        <span class="wa-node-kind">@item.node.Kind</span>
                        <strong>@(item.node.Title ?? item.node.Id)</strong>
                        <small>@NodeMeta(item.node)</small>
                    </button>
                    <div class="wa-edge-handle" style="left:@(position.X + NodeWidth)px;top:@(position.Y + NodeHeight / 2)px"
                         data-edge-handle data-node-id="@item.node.Id" data-pw="graph-edge-handle"
                         title="ドラッグして別のノードにつなぐとエッジができます"></div>
                }
                @if (selectedEdgeId is not null && edgeGeometry.FirstOrDefault(g => g.Edge.Id == selectedEdgeId) is { } selectedGeo)
                {
                    <button type="button" class="wa-edge-delete-btn" style="left:@(selectedGeo.MidX)px;top:@(selectedGeo.MidY)px"
                            @onclick="() => RemoveEdge(selectedGeo.Edge)" @onclick:stopPropagation="true"
                            data-pw="graph-edge-delete-inline" title="このエッジを削除">×</button>
                }
            </div>
        </div>

        <NarrationPanel Title="@(editingSubgraphId is null ? "このグラフはこう動きます" : $"サブグラフ「{editingSubgraphId}」はこう動きます")"
                        Headline="@DefinitionNarrator.Headline(CanvasGraph)"
                        Lines="@narration" />
    </main>

    <aside class="wa-graph-inspector">
        <div class="wa-inspector-tabs">
            <button type="button" class="@TabClass("node")" @onclick="@(() => SetTab("node"))" data-pw="inspector-tab-node">ノード</button>
            <button type="button" class="@TabClass("edges")" @onclick="@(() => SetTab("edges"))" data-pw="inspector-tab-edges">エッジ (@edges.Count)</button>
            <button type="button" class="@TabClass("graph")" @onclick="@(() => SetTab("graph"))" data-pw="inspector-tab-graph">グラフ</button>
            <button type="button" class="@TabClass("yaml")" @onclick="@(() => SetTab("yaml"))" data-pw="inspector-tab-yaml">YAML</button>
        </div>

        <div class="wa-inspector-body">
            @switch (inspectorTab)
            {
                case "node":
                    @if (SelectedNode is null)
                    {
                        <div class="wa-empty">ノードを選択してください。</div>
                    }
                    else
                    {
                        var node = SelectedNode;
                        <div class="wa-inspector-head">
                            <span class="wa-tag wa-tag-purple">@node.Kind.ToString().ToLowerInvariant()</span>
                            <button type="button" class="wa-btn wa-btn-sm wa-btn-danger" @onclick="DeleteSelectedNode" data-pw="graph-delete-node">このノードを削除</button>
                        </div>

                        <div class="wa-subsection" data-pw="node-connected-edges">
                            <div class="wa-subsection-head">つながっているエッジ (@ConnectedEdges(node.Id).Count)</div>
                            @if (ConnectedEdges(node.Id).Count == 0)
                            {
                                <p class="wa-field-help">エッジがありません。キャンバス上のノード右側にある丸いハンドルを他のノードへドラッグするとつながります。</p>
                            }
                            else
                            {
                                @foreach (var edge in ConnectedEdges(node.Id))
                                {
                                    var captured = edge;
                                    var isOutgoing = captured.From == node.Id;
                                    <div class="wa-edge-card @(selectedEdgeId == captured.Id ? "selected" : null)" @onclick="() => SelectEdge(captured.Id)">
                                        <div class="wa-edge-card-head">
                                            <span class="wa-edge-card-route">
                                                <span class="wa-edge-card-role">From</span>
                                                <span class="wa-tag @(isOutgoing ? "wa-tag-accent" : null)">@captured.From</span>
                                                <span class="wa-edge-card-arrow">→</span>
                                                <span class="wa-edge-card-role">To</span>
                                                <span class="wa-tag @(!isOutgoing ? "wa-tag-accent" : null)">@captured.To</span>
                                            </span>
                                            <button type="button" class="wa-btn wa-btn-sm wa-btn-danger" @onclick="() => RemoveEdge(captured)" @onclick:stopPropagation="true">削除</button>
                                        </div>
                                    </div>
                                }
                            }
                            <button type="button" class="wa-btn wa-btn-sm" @onclick="() => AddEdgeFrom(node.Id)" data-pw="graph-add-edge-from-node">+ 出力エッジを追加</button>
                        </div>

                        @foreach (var field in VisibleNodeFields(node))
                        {
                            @if (field.Name == "codeFile" && node.Kind == NodeKind.Code)
                            {
                                <SchemaField Field="field"
                                             Value="@NodeValue(node, field.Name)"
                                             ValueChanged="@(value => SetNodeValue(field.Name, value))"
                                             Options="referenceOptions">
                                    <TrailingAction>
                                        <button type="button" class="wa-field-icon-btn" @onclick="() => OpenCodeFileFolder(node)"
                                                data-pw="graph-open-code-folder" title="フォルダを開く" aria-label="フォルダを開く">
                                            <span class="wa-icon" aria-hidden="true">folder_open</span>
                                        </button>
                                    </TrailingAction>
                                </SchemaField>
                            }
                            else if (field.Name == "body" && node.Kind == NodeKind.Loop)
                            {
                                <SchemaField Field="field"
                                             Value="@NodeValue(node, field.Name)"
                                             ValueChanged="@(value => SetNodeValue(field.Name, value))"
                                             Options="referenceOptions">
                                    <TrailingAction>
                                        @if (!string.IsNullOrWhiteSpace(node.Body) && subgraphs.ContainsKey(node.Body!))
                                        {
                                            <button type="button" class="wa-field-icon-btn" @onclick="() => EnterSubgraph(node.Body!)"
                                                    disabled="@(editingSubgraphId is not null)"
                                                    data-pw="graph-jump-to-subgraph" title="このサブグラフを編集" aria-label="このサブグラフを編集">
                                                <span class="wa-icon" aria-hidden="true">open_in_new</span>
                                            </button>
                                        }
                                    </TrailingAction>
                                </SchemaField>
                            }
                            else
                            {
                                <SchemaField Field="field"
                                             Value="@NodeValue(node, field.Name)"
                                             ValueChanged="@(value => SetNodeValue(field.Name, value))"
                                             Options="referenceOptions" />
                            }
                        }

                        @if (node.Kind == NodeKind.Loop)
                        {
                            var stopField = NodeField("stop");
                            if (stopField is not null)
                            {
                                <div class="wa-subsection">
                                    <div class="wa-subsection-head">停止条件 (stop)</div>
                                    <p class="wa-field-help">@stopField.Description</p>
                                    @foreach (var field in stopField.Fields.OrderBy(f => f.Order))
                                    {
                                        <SchemaField Field="field"
                                                     Value="@NodeValue(node, $"stop.{field.Name}")"
                                                     ValueChanged="@(value => SetNodeValue($"stop.{field.Name}", value))"
                                                     Options="referenceOptions" />
                                    }
                                </div>
                            }

                            var evaluatorField = NodeField("evaluator");
                            if (evaluatorField is not null)
                            {
                                <div class="wa-subsection">
                                    <div class="wa-subsection-head">評価者 (evaluator)</div>
                                    @foreach (var field in evaluatorField.Fields.OrderBy(f => f.Order)
                                        .Where(f => f.IsVisible(name => NodeValue(node, $"evaluator.{name}"))))
                                    {
                                        if (field.Type == UiFieldType.Array)
                                        {
                                            <div class="wa-field">
                                                <label><span>metrics</span></label>
                                                <p class="wa-field-help">@field.Description</p>
                                                @foreach (var metric in node.Evaluator?.Metrics ?? Array.Empty<MetricTarget>())
                                                {
                                                    var captured = metric;
                                                    <div class="wa-row-card">
                                                        <span>@captured.Name</span>
                                                        <span>@(string.Equals(captured.Direction, "lte", StringComparison.OrdinalIgnoreCase) ? "≦" : "≧") @captured.Target</span>
                                                        <button type="button" class="wa-btn wa-btn-sm" @onclick="() => RemoveMetric(captured)">削除</button>
                                                    </div>
                                                }
                                                <div class="wa-row-card">
                                                    <input class="wa-input" placeholder="指標名" @bind="newMetricName" />
                                                    <input class="wa-input" type="number" step="any" placeholder="目標値" @bind="newMetricTarget" />
                                                    <select class="wa-input" @bind="newMetricDirection">
                                                        <option value="gte">gte (目標値以上で合格)</option>
                                                        <option value="lte">lte (目標値以下で合格)</option>
                                                    </select>
                                                    <button type="button" class="wa-btn wa-btn-sm" @onclick="AddMetric">追加</button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <SchemaField Field="field"
                                                         Value="@NodeValue(node, $"evaluator.{field.Name}")"
                                                         ValueChanged="@(value => SetNodeValue($"evaluator.{field.Name}", value))"
                                                         Options="referenceOptions" />
                                        }
                                    }
                                </div>
                            }
                        }

                        <div class="wa-note">@DefinitionNarrator.DescribeNode(node, CanvasGraph)</div>
                    }
                    break;

                case "edges":
                    <div class="wa-subsection">
                        <div class="wa-subsection-head">エッジ</div>
                        @if (edges.Count == 0)
                        {
                            <div class="wa-empty">エッジがありません。ノードをつなぐと実行順が決まります。</div>
                        }
                        @foreach (var edge in edges.ToArray())
                        {
                            var captured = edge;
                            <div class="wa-edge-card @(selectedEdgeId == captured.Id ? "selected" : null)" data-pw="edge-card" @onclick="() => SelectEdge(captured.Id)">
                                <div class="wa-edge-card-head">
                                    <span class="wa-tag">@captured.Id</span>
                                    <button type="button" class="wa-btn wa-btn-sm wa-btn-danger" @onclick="() => RemoveEdge(captured)" @onclick:stopPropagation="true">削除</button>
                                </div>
                                @foreach (var field in EdgeFields.Where(f => !f.Advanced))
                                {
                                    <SchemaField Field="field"
                                                 Value="@EdgeValue(captured, field.Name)"
                                                 ValueChanged="@(value => SetEdgeValue(captured, field.Name, value))"
                                                 Options="referenceOptions" />
                                }
                            </div>
                        }
                        <button type="button" class="wa-btn wa-btn-sm" @onclick="AddEdge" data-pw="graph-add-edge">+ エッジを追加</button>
                    </div>
                    break;

                case "graph":
                    @foreach (var field in GraphScalarFields)
                    {
                        <SchemaField Field="field"
                                     Value="@GraphValue(field.Name)"
                                     ValueChanged="@(value => SetGraphValue(field.Name, value))"
                                     Options="referenceOptions" />
                    }
                    <div class="wa-subsection">
                        <div class="wa-subsection-head">既定値 (defaults)</div>
                        @if (DefaultTeamField is not null)
                        {
                            <SchemaField Field="DefaultTeamField"
                                         Value="@defaults.Team"
                                         ValueChanged="@(value => { defaults = defaults with { Team = value }; MarkDirty(); })"
                                         Options="referenceOptions" />
                        }
                        @if (BudgetCostField is not null)
                        {
                            <SchemaField Field="BudgetCostField"
                                         Value="@Text(defaults.BudgetCostLimitUsd)"
                                         ValueChanged="@(value => { defaults = defaults with { BudgetCostLimitUsd = ParseDouble(value) }; MarkDirty(); })" />
                        }
                        @if (BudgetTimeField is not null)
                        {
                            <SchemaField Field="BudgetTimeField"
                                         Value="@defaults.BudgetTimeLimitSeconds?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                         ValueChanged="@(value => { defaults = defaults with { BudgetTimeLimitSeconds = ParseInt(value) }; MarkDirty(); })" />
                        }
                    </div>
                    <div class="wa-subsection" data-pw="subgraphs-section">
                        <div class="wa-subsection-head">サブグラフ</div>
                        <p class="wa-field-help">LOOP ノードの body などから選ぶ内部グラフです。追加すると、ノードタブの「body」欄で選べるようになります。「編集」でこのキャンバス上のまま中身のノード/エッジを編集できます。</p>
                        @if (subgraphs.Count == 0)
                        {
                            <div class="wa-empty">サブグラフはまだありません。</div>
                        }
                        else
                        {
                            @foreach (var pair in subgraphs)
                            {
                                var subgraphId = pair.Key;
                                <div class="wa-row-card">
                                    <span>@subgraphId</span>
                                    <span>ノード @pair.Value.Nodes.Count 件 / エッジ @pair.Value.Edges.Count 件</span>
                                    <button type="button" class="wa-btn wa-btn-sm" disabled="@(editingSubgraphId is not null)"
                                            @onclick="() => EnterSubgraph(subgraphId)" data-pw="graph-edit-subgraph">編集</button>
                                </div>
                            }
                        }
                        <button type="button" class="wa-btn wa-btn-sm" disabled="@(editingSubgraphId is not null)"
                                @onclick="AddSubgraph" data-pw="graph-add-subgraph">+ サブグラフを追加</button>
                    </div>
                    break;

                case "yaml":
                    <div class="wa-subsection">
                        <div class="wa-subsection-head">graph.yaml</div>
                        <p class="wa-field-help">保存するとこの内容が書き出されます。コメントは保持されません。</p>
                        <pre class="wa-yaml" data-pw="graph-yaml">@Authoring.ToYaml(WorkingGraph)</pre>
                    </div>
                    break;
            }
        </div>

        <DiagnosticList Diagnostics="diagnostics"
                        ValidMessage="このグラフは検証を通りました。"
                        IdleMessage="検証を押すと、参照切れや到達できないノードを確認できます。"
                        NodeSelected="SelectNode" />
    </aside>
</div>
}

@code {
    [Parameter] public string? GraphName { get; set; }

    private const double NodeWidth = 150;
    private const double NodeHeight = 86;
    private const double ColumnGap = 48;
    private const double RowGap = 34;
    private const double OriginX = 40;
    private const double OriginY = 40;

    private static UiSchemaDocument Schema => UiSchemaCatalog.Get("graph");
    private static UiField NodeDefinition => Schema.Definition("node")!;
    private static UiField EdgeDefinition => Schema.Definition("edge")!;

    private GraphDefinition? original;
    private List<GraphNode> nodes = new();
    private List<GraphEdge> edges = new();
    private Dictionary<string, (double X, double Y)> layout = new(StringComparer.Ordinal);
    private Dictionary<string, SubgraphDefinition> subgraphs = new(StringComparer.Ordinal);

    /// <summary>サブグラフ編集中に退避しておくルート側の nodes/edges/layout。</summary>
    private List<GraphNode> rootNodes = new();
    private List<GraphEdge> rootEdges = new();
    private Dictionary<string, (double X, double Y)> rootLayout = new(StringComparer.Ordinal);

    /// <summary>null ならルートを編集中。値があれば、その ID のサブグラフの中身を nodes/edges/layout に読み込んで編集中。</summary>
    private string? editingSubgraphId;

    private GraphDefaults defaults = new();
    private string name = string.Empty;
    private string? displayName;
    private string? description;

    private string? selectedNodeId;
    private string? selectedEdgeId;
    private string inspectorTab = "node";
    private ElementReference canvasScrollRef;
    private ElementReference canvasInnerRef;
    private ElementReference edgePreviewRef;
    private DotNetObjectReference<GraphStudio>? dotNetRef;
    private bool isDirty;
    private bool isSaving;
    private string? savedMessage;
    private IReadOnlyList<AuthoringDiagnostic>? diagnostics;
    private IReadOnlyList<NarrationLine> narration = Array.Empty<NarrationLine>();
    private ReferenceOptions referenceOptions = ReferenceOptions.Empty;
    private Dictionary<string, (double X, double Y)> displayLayout = new(StringComparer.Ordinal);
    private (double Width, double Height) canvasSize = (1120, 560);

    private sealed record EditorSnapshot(
        List<GraphNode> Nodes,
        List<GraphEdge> Edges,
        Dictionary<string, (double X, double Y)> Layout,
        GraphDefaults Defaults,
        string Name,
        string? DisplayName,
        string? Description,
        Dictionary<string, SubgraphDefinition> Subgraphs);

