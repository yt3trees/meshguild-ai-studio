    // ------------------------------------------------------------ ノード編集

    /// <summary>kind に応じて意味を持つ項目だけを返す (案B)。出し分けの根拠はスキーマの x-ui.showWhen。</summary>
    private IReadOnlyList<UiField> VisibleNodeFields(GraphNode node)
        => NodeDefinition.Fields
            .Where(field => field.Type is UiFieldType.String or UiFieldType.Integer or UiFieldType.Number or UiFieldType.Boolean)
            .Where(field => !field.Deprecated)
            .Where(field => field.IsVisible(sibling => NodeValue(node, sibling)))
            .OrderBy(field => field.Order)
            .ToArray();

    private static UiField? NodeField(string name) => NodeDefinition.Field(name);

    private string? NodeValue(GraphNode node, string path) => path switch
    {
        "id" => node.Id,
        "kind" => node.Kind.ToString().ToLowerInvariant(),
        "agent" => node.Agent,
        "team" => node.Team,
        "input" => node.Input,
        "goal" => node.Goal,
        "body" => node.Body,
        "title" => node.Title,
        "summary" => node.Summary,
        "timeoutSeconds" => node.TimeoutSeconds?.ToString(System.Globalization.CultureInfo.InvariantCulture),
        "codeFile" => node.CodeFile,
        "graph" => node.Graph,
        "joinPolicy" => node.JoinPolicy?.ToString().ToLowerInvariant(),
        "onPartialFailure" => node.OnPartialFailure?.ToString().ToLowerInvariant(),
        "alternate" => node.Alternate,
        "stop.maxIterations" => node.Stop?.MaxIterations.ToString(System.Globalization.CultureInfo.InvariantCulture),
        "stop.costLimitUsd" => Text(node.Stop?.CostLimitUsd),
        "stop.timeLimitSeconds" => node.Stop?.TimeLimitSeconds?.ToString(System.Globalization.CultureInfo.InvariantCulture),
        "stop.scoreThreshold" => Text(node.Stop?.ScoreThreshold),
        "evaluator.kind" => node.Evaluator?.Kind,
        "evaluator.node" => node.Evaluator?.Node,
        "evaluator.agent" => node.Evaluator?.Agent,
        _ => null,
    };

    private void SetNodeValue(string path, string? value)
    {
        var node = SelectedNode;
        if (node is null)
        {
            return;
        }
        var index = nodes.IndexOf(node);
        var updated = node;

        switch (path)
        {
            case "id":
                var newId = value?.Trim();
                if (string.IsNullOrWhiteSpace(newId) || newId == node.Id)
                {
                    return;
                }
                RenameNode(node.Id, newId);
                return;
            case "kind":
                if (Enum.TryParse<NodeKind>(value, ignoreCase: true, out var kind))
                {
                    updated = ClearFieldsNotUsedBy(node with { Kind = kind }, kind);
                }
                break;
            case "agent": updated = node with { Agent = value }; break;
            case "team": updated = node with { Team = value }; break;
            case "input": updated = node with { Input = value }; break;
            case "goal": updated = node with { Goal = value }; break;
            case "body": updated = node with { Body = value }; break;
            case "title": updated = node with { Title = value }; break;
            case "summary": updated = node with { Summary = value }; break;
            case "timeoutSeconds": updated = node with { TimeoutSeconds = ParseInt(value) }; break;
            case "codeFile": updated = node with { CodeFile = value }; break;
            case "graph": updated = node with { Graph = value }; break;
            case "joinPolicy":
                updated = node with { JoinPolicy = Enum.TryParse<JoinPolicy>(value, true, out var join) ? join : null };
                break;
            case "onPartialFailure":
                updated = node with { OnPartialFailure = Enum.TryParse<PartialFailurePolicy>(value, true, out var failure) ? failure : null };
                break;
            case "alternate": updated = node with { Alternate = value }; break;
            case "stop.maxIterations": updated = node with { Stop = Stop(node) with { MaxIterations = ParseInt(value) ?? 10 } }; break;
            case "stop.costLimitUsd": updated = node with { Stop = Stop(node) with { CostLimitUsd = ParseDouble(value) } }; break;
            case "stop.timeLimitSeconds": updated = node with { Stop = Stop(node) with { TimeLimitSeconds = ParseInt(value) } }; break;
            case "stop.scoreThreshold": updated = node with { Stop = Stop(node) with { ScoreThreshold = ParseDouble(value) } }; break;
            case "evaluator.kind":
                updated = string.IsNullOrWhiteSpace(value)
                    ? node with { Evaluator = null }
                    : node with { Evaluator = Evaluator(node) with { Kind = value } };
                break;
            case "evaluator.node": updated = node with { Evaluator = Evaluator(node) with { Node = value } }; break;
            case "evaluator.agent": updated = node with { Evaluator = Evaluator(node) with { Agent = value } }; break;
            default: return;
        }

        nodes[index] = updated;
        MarkDirty();
    }

    private static LoopStopCondition Stop(GraphNode node) => node.Stop ?? new LoopStopCondition();

    private static NodeEvaluatorSpec Evaluator(GraphNode node)
        => node.Evaluator ?? new NodeEvaluatorSpec { Kind = "agent" };

    /// <summary>
    /// kind を変えたとき、新しい kind では意味を持たない項目を消す。
    /// 残しておくと YAML に読み手を惑わせる値が残るため。判定はスキーマの showWhen に従う。
    /// </summary>
    private static GraphNode ClearFieldsNotUsedBy(GraphNode node, NodeKind kind)
    {
        var kindText = kind.ToString().ToLowerInvariant();
        bool Applies(string fieldName)
        {
            var field = NodeDefinition.Field(fieldName);
            if (field is null || !field.ShowWhen.TryGetValue("kind", out var allowed))
            {
                return true;
            }
            return allowed.Contains(kindText, StringComparer.Ordinal);
        }

        return node with
        {
            Agent = Applies("agent") ? node.Agent : null,
            Team = Applies("team") ? node.Team : null,
            Input = Applies("input") ? node.Input : null,
            Goal = Applies("goal") ? node.Goal : null,
            Body = Applies("body") ? node.Body : null,
            Title = Applies("title") ? node.Title : null,
            Summary = Applies("summary") ? node.Summary : null,
            TimeoutSeconds = Applies("timeoutSeconds") ? node.TimeoutSeconds : null,
            CodeFile = Applies("codeFile") ? node.CodeFile : null,
            Graph = Applies("graph") ? node.Graph : null,
            JoinPolicy = Applies("joinPolicy") ? node.JoinPolicy : null,
            OnPartialFailure = Applies("onPartialFailure") ? node.OnPartialFailure : null,
            Alternate = Applies("alternate") ? node.Alternate : null,
            Stop = kind == NodeKind.Loop ? node.Stop ?? new LoopStopCondition() : null,
            Evaluator = kind == NodeKind.Loop ? node.Evaluator : null,
        };
    }

    /// <summary>ノード ID の変更に合わせて、それを指すエッジと座標も直す。</summary>
    private void RenameNode(string oldId, string newId)
    {
        for (var index = 0; index < nodes.Count; index++)
        {
            if (nodes[index].Id == oldId)
            {
                nodes[index] = nodes[index] with { Id = newId };
            }
            if (nodes[index].Alternate == oldId)
            {
                nodes[index] = nodes[index] with { Alternate = newId };
            }
        }
        for (var index = 0; index < edges.Count; index++)
        {
            var edge = edges[index];
            var from = edge.From == oldId ? newId : edge.From;
            var to = edge.To == oldId ? newId : edge.To;
            var id = edge.Id == $"{edge.From}-to-{edge.To}" ? $"{from}-to-{to}" : edge.Id;
            edges[index] = edge with { From = from, To = to, Id = id };
        }
        if (layout.Remove(oldId, out var position))
        {
            layout[newId] = position;
        }
        selectedNodeId = newId;
        MarkDirty();
    }

    private void AddNode()
    {
        var id = UniqueNodeId("node");
        var position = NextFreePosition();
        nodes.Add(new GraphNode { Id = id, Kind = NodeKind.Agent });
        layout[id] = position;
        selectedNodeId = id;
        inspectorTab = "node";
        MarkDirty();
    }

    /// <summary>空のサブグラフを1件追加する。LOOP ノードの body 欄などから選べるようにするための最小構成。</summary>
    private void AddSubgraph()
    {
        if (editingSubgraphId is not null)
        {
            return;
        }
        var id = UniqueSubgraphId("subgraph");
        subgraphs[id] = new SubgraphDefinition
        {
            Nodes = new List<GraphNode> { new GraphNode { Id = "start", Kind = NodeKind.Agent } },
            Edges = new List<GraphEdge>(),
        };
        MarkDirty();
    }

    /// <summary>キャンバスの編集対象をサブグラフに切り替える。ルートの nodes/edges/layout は退避しておき、戻るときに復元する。</summary>
    private void EnterSubgraph(string subgraphId)
    {
        if (editingSubgraphId is not null || !subgraphs.TryGetValue(subgraphId, out var sub))
        {
            return;
        }
        rootNodes = nodes;
        rootEdges = edges;
        rootLayout = layout;
        editingSubgraphId = subgraphId;
        nodes = sub.Nodes.ToList();
        edges = sub.Edges.ToList();
        layout = new Dictionary<string, (double X, double Y)>(StringComparer.Ordinal);
        selectedNodeId = null;
        selectedEdgeId = null;
        inspectorTab = "node";
        undoStack.Clear();
        lastCommitted = CaptureSnapshot();
        Refresh();
    }

    /// <summary>サブグラフ編集を終え、ルートの編集に戻る。編集内容は subgraphs 辞書へ書き戻す。</summary>
    private void ExitSubgraph()
    {
        if (editingSubgraphId is null)
        {
            return;
        }
        subgraphs[editingSubgraphId] = new SubgraphDefinition { Nodes = nodes, Edges = edges };
        editingSubgraphId = null;
        nodes = rootNodes;
        edges = rootEdges;
        layout = rootLayout;
        selectedNodeId = null;
        selectedEdgeId = null;
        inspectorTab = "node";
        undoStack.Clear();
        lastCommitted = CaptureSnapshot();
        Refresh();
    }

    private string UniqueSubgraphId(string prefix)
    {
        var candidate = prefix;
        var counter = 2;
        while (subgraphs.ContainsKey(candidate))
        {
            candidate = $"{prefix}-{counter++}";
        }
        return candidate;
    }

    /// <summary>codeFile を編集するために、それが入っているフォルダを OS のファイラーで開く (ローカル実行前提)。</summary>
    private void OpenCodeFileFolder(GraphNode node)
    {
        if (string.IsNullOrWhiteSpace(original?.FolderPath) || string.IsNullOrWhiteSpace(node.CodeFile))
        {
            return;
        }
        var fullPath = System.IO.Path.GetFullPath(System.IO.Path.Combine(original.FolderPath, node.CodeFile));
        var folder = System.IO.File.Exists(fullPath)
            ? System.IO.Path.GetDirectoryName(fullPath)
            : (System.IO.Directory.Exists(fullPath) ? fullPath : original.FolderPath);
        if (string.IsNullOrWhiteSpace(folder) || !System.IO.Directory.Exists(folder))
        {
            return;
        }
        try
        {
            if (System.IO.File.Exists(fullPath))
            {
                System.Diagnostics.Process.Start("explorer.exe", $"/select,\"{fullPath}\"");
            }
            else
            {
                System.Diagnostics.Process.Start("explorer.exe", $"\"{folder}\"");
            }
        }
        catch (System.ComponentModel.Win32Exception)
        {
            // ローカル実行以外 (別ホストでの表示等) では開けないことがあるが、致命的ではないので無視する。
        }
    }

    private void DeleteSelectedNode()
    {
        var node = SelectedNode;
        if (node is null)
        {
            return;
        }
        nodes.Remove(node);
        edges.RemoveAll(edge => edge.From == node.Id || edge.To == node.Id);
        layout.Remove(node.Id);
        selectedNodeId = nodes.FirstOrDefault()?.Id;
        MarkDirty();
    }

    private string UniqueNodeId(string prefix)
    {
        var candidate = prefix;
        var counter = 2;
        while (nodes.Any(node => string.Equals(node.Id, candidate, StringComparison.Ordinal)))
        {
            candidate = $"{prefix}-{counter++}";
        }
        return candidate;
    }

    private (double X, double Y) NextFreePosition()
    {
        var maxX = displayLayout.Values.Select(position => position.X).DefaultIfEmpty(OriginX).Max();
        return (maxX + NodeWidth + ColumnGap, OriginY);
    }

    private void AddMetric()
    {
        var node = SelectedNode;
        if (node is null || string.IsNullOrWhiteSpace(newMetricName))
        {
            return;
        }
        var evaluator = Evaluator(node);
        var metrics = evaluator.Metrics.Append(new MetricTarget
        {
            Name = newMetricName.Trim(),
            Target = newMetricTarget,
            Direction = newMetricDirection,
        }).ToArray();
        nodes[nodes.IndexOf(node)] = node with { Evaluator = evaluator with { Metrics = metrics } };
        newMetricName = string.Empty;
        newMetricTarget = 0;
        MarkDirty();
    }

    private void RemoveMetric(MetricTarget metric)
    {
        var node = SelectedNode;
        if (node?.Evaluator is null)
        {
            return;
        }
        var metrics = node.Evaluator.Metrics.Where(item => item != metric).ToArray();
        nodes[nodes.IndexOf(node)] = node with { Evaluator = node.Evaluator with { Metrics = metrics } };
        MarkDirty();
    }

    // ------------------------------------------------------------ エッジ編集

    private string? EdgeValue(GraphEdge edge, string name) => name switch
    {
        "id" => edge.Id,
        "from" => edge.From,
        "to" => edge.To,
        "condition" => edge.Condition,
        "loopBack" => edge.LoopBack ? "true" : null,
        _ => null,
    };

    private void SetEdgeValue(GraphEdge edge, string name, string? value)
    {
        var index = edges.IndexOf(edge);
        if (index < 0)
        {
            return;
        }
        edges[index] = name switch
        {
            "id" => edge with { Id = string.IsNullOrWhiteSpace(value) ? edge.Id : value },
            "from" => edge with { From = value ?? string.Empty },
            "to" => edge with { To = value ?? string.Empty },
            "condition" => edge with { Condition = value },
            "loopBack" => edge with { LoopBack = string.Equals(value, "true", StringComparison.OrdinalIgnoreCase) },
            _ => edge,
        };
        MarkDirty();
    }

    private void AddEdge()
    {
        var from = SelectedNode?.Id ?? nodes.FirstOrDefault()?.Id ?? string.Empty;
        var to = nodes.FirstOrDefault(node => node.Id != from)?.Id ?? from;
        var created = new GraphEdge { Id = UniqueEdgeId(from, to), From = from, To = to };
        edges.Add(created);
        selectedEdgeId = created.Id;
        inspectorTab = "edges";
        MarkDirty();
    }

    /// <summary>ノードタブから「+ 出力エッジを追加」を押したときの追加。行き先はエッジタブでそのまま選び直せる。</summary>
    private void AddEdgeFrom(string fromNodeId)
    {
        var to = nodes.FirstOrDefault(node => node.Id != fromNodeId)?.Id ?? fromNodeId;
        var created = new GraphEdge { Id = UniqueEdgeId(fromNodeId, to), From = fromNodeId, To = to };
        edges.Add(created);
        selectedEdgeId = created.Id;
        MarkDirty();
    }

    private string UniqueEdgeId(string from, string to)
    {
        var candidate = $"{from}-to-{to}";
        var counter = 2;
        while (edges.Any(edge => string.Equals(edge.Id, candidate, StringComparison.Ordinal)))
        {
            candidate = $"{from}-to-{to}-{counter++}";
        }
        return candidate;
    }

    private void RemoveEdge(GraphEdge edge)
    {
        edges.Remove(edge);
        if (selectedEdgeId == edge.Id)
        {
            selectedEdgeId = null;
        }
        MarkDirty();
    }

    // ------------------------------------------------------------ グラフ全体

    private string? GraphValue(string fieldName) => fieldName switch
    {
        "name" => name,
        "displayName" => displayName,
        "description" => description,
        _ => null,
    };

    private void SetGraphValue(string fieldName, string? value)
    {
        switch (fieldName)
        {
            case "name": name = value?.Trim() ?? string.Empty; break;
            case "displayName": displayName = value; break;
            case "description": description = value; break;
            default: return;
        }
        MarkDirty();
    }

    // ---------------------------------------------------------- 検証 / 保存

    private string? toastMessage;
    private string? toastKind;
    private int toastToken;

    private void Validate()
    {
        diagnostics = Authoring.ValidateGraph(WorkingGraph);
        Refresh();
        ShowToast(
            diagnostics.Count == 0 ? "検証しました。問題は見つかりませんでした。" : $"検証しました。{diagnostics.Count} 件の問題があります。",
            diagnostics.Count == 0 ? "success" : "warn");
    }

    /// <summary>右上に一定時間だけメッセージを出す。連続で押されたら前のタイマーは無視し、最後の1回だけが消灯を担う。</summary>
    private void ShowToast(string message, string kind)
    {
        toastMessage = message;
        toastKind = kind;
        var token = ++toastToken;
        _ = HideToastAfterDelay(token);
    }

    private async Task HideToastAfterDelay(int token)
    {
        await Task.Delay(3500);
        if (token == toastToken)
        {
            toastMessage = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        try
        {
            var result = await Authoring.SaveGraphAsync(WorkingGraph);
            diagnostics = result.Diagnostics.Count > 0 ? result.Diagnostics : Array.Empty<AuthoringDiagnostic>();
            if (result.Saved)
            {
                var savedName = name;
                var savedPath = result.Path;
                LoadGraph(Authoring.FindGraph(savedName) ?? WorkingGraph);
                savedMessage = $"{savedPath} に保存しました。実行への反映はアプリの再起動後です。";
                if (!string.Equals(savedName, GraphName, StringComparison.Ordinal))
                {
                    Navigation.NavigateTo($"graphs/{savedName}");
                }
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    // -------------------------------------------------------------- レイアウト

    private (double X, double Y) PositionOf(string nodeId)
        => displayLayout.TryGetValue(nodeId, out var position) ? position : (OriginX, OriginY);

    private (double Width, double Height) ComputeCanvasSize()
    {
        if (displayLayout.Count == 0)
        {
            return (1120, 560);
        }
        var maxX = displayLayout.Values.Max(position => position.X);
        var maxY = displayLayout.Values.Max(position => position.Y);
        // 下側は迂回ルート (ループバック用レーン) の分だけ余白を多めに確保する。
        return (Math.Max(1120, maxX + NodeWidth + 40), Math.Max(560, maxY + NodeHeight + 90));
    }

    private sealed record EdgeGeometry(GraphEdge Edge, double X1, double Y1, double X2, double Y2, string? PathD, double MidX, double MidY);

    /// <summary>
    /// エッジの描画座標を組み立てる。同じノードに集まる複数のエッジは接続点をずらして重なりを避け (ファンアウト)、
    /// 列を2つ以上飛ばす転送エッジと loopBack エッジは、他のノードの上を絶対に通らないよう、
    /// すべてのノードより上/下にある専用レーンを経由する直角の迂回ルートで描く。
    /// </summary>
    private List<EdgeGeometry> ComputeEdgeGeometry()
    {
        var forward = edges.Where(edge => !edge.LoopBack).ToList();
        var loopEdges = edges.Where(edge => edge.LoopBack).ToList();

        var outgoingOrder = forward.GroupBy(edge => edge.From, StringComparer.Ordinal)
            .ToDictionary(
                group => group.Key,
                group => group.OrderBy(edge => PositionOf(edge.To).Y).Select(edge => edge.Id).ToList(),
                StringComparer.Ordinal);
        var incomingOrder = forward.GroupBy(edge => edge.To, StringComparer.Ordinal)
            .ToDictionary(
                group => group.Key,
                group => group.OrderBy(edge => PositionOf(edge.From).Y).Select(edge => edge.Id).ToList(),
                StringComparer.Ordinal);

        double FanOffset(string edgeId, string nodeId, Dictionary<string, List<string>> orderMap)
        {
            if (!orderMap.TryGetValue(nodeId, out var list) || list.Count <= 1)
            {
                return 0;
            }
            var index = list.IndexOf(edgeId);
            var span = Math.Min(NodeHeight * 0.55, (list.Count - 1) * 13);
            var step = span / (list.Count - 1);
            return -span / 2 + step * index;
        }

        var columnStride = NodeWidth + ColumnGap;
        var minNodeY = displayLayout.Count == 0 ? OriginY : displayLayout.Values.Min(position => position.Y);
        var maxNodeBottom = displayLayout.Count == 0 ? OriginY + NodeHeight : displayLayout.Values.Max(position => position.Y) + NodeHeight;
        var topLaneY = Math.Max(4, minNodeY - 26);
        var bottomLaneY = maxNodeBottom + 26;

        var result = new List<EdgeGeometry>();

        foreach (var edge in forward)
        {
            var from = PositionOf(edge.From);
            var to = PositionOf(edge.To);
            var x1 = from.X + NodeWidth;
            var y1 = from.Y + NodeHeight / 2 + FanOffset(edge.Id, edge.From, outgoingOrder);
            var x2 = to.X;
            var y2 = to.Y + NodeHeight / 2 + FanOffset(edge.Id, edge.To, incomingOrder);

            // 隣り合う列同士なら間には何もないので直線で結んでよい。2 列以上離れている場合は
            // 中間の列に別の行のノードが置かれている可能性があるため、必ず全ノードより上のレーンを経由させる。
            if (to.X - from.X > columnStride * 1.5 || to.X <= from.X)
            {
                var pathData = ElbowPath(x1, y1, x2, y2, topLaneY);
                result.Add(new EdgeGeometry(edge, x1, y1, x2, y2, pathData, (x1 + x2) / 2, topLaneY));
            }
            else
            {
                result.Add(new EdgeGeometry(edge, x1, y1, x2, y2, null, (x1 + x2) / 2, (y1 + y2) / 2));
            }
        }

        foreach (var edge in loopEdges)
        {
            var from = PositionOf(edge.From);
            var to = PositionOf(edge.To);
            var x1 = from.X + NodeWidth;
            var y1 = from.Y + NodeHeight - 14;
            var x2 = to.X;
            var y2 = to.Y + NodeHeight - 14;
            var pathData = ElbowPath(x1, y1, x2, y2, bottomLaneY);
            result.Add(new EdgeGeometry(edge, x1, y1, x2, y2, pathData, (x1 + x2) / 2, bottomLaneY));
        }

        return result;
    }

    /// <summary>
    /// ノードの縁から少し伸ばしてから直角に曲げる形の経路を作る。曲がり角がノードのすぐ際に来ないよう、
    /// 縁から stub 分だけ水平に出てから、レーンへ向けて曲がる。
    /// </summary>
    private static string ElbowPath(double x1, double y1, double x2, double y2, double laneY)
    {
        const double stub = 22;
        var stubOutX = x1 + stub;
        var stubInX = x2 - stub;
        return FormattableString.Invariant(
            $"M {x1} {y1} L {stubOutX} {y1} L {stubOutX} {laneY} L {stubInX} {laneY} L {stubInX} {y2} L {x2} {y2}");
    }

    /// <summary>
    /// 明示座標と自動座標を表示用に統合し、既存ノードと重なる座標だけを下へ移動する。
    /// 明示座標は通常そのまま使い、衝突時だけ後続ノードをずらす。
    /// </summary>
    private static Dictionary<string, (double X, double Y)> ComputeDisplayLayout(GraphDefinition graph)
    {
        var automatic = ComputeAutoLayout(graph);
        var display = new Dictionary<string, (double X, double Y)>(StringComparer.Ordinal);

        foreach (var item in graph.Nodes.Select((node, index) => (node, index)))
        {
            (double X, double Y) position = graph.Layout.TryGetValue(item.node.Id, out var explicitPosition)
                ? (explicitPosition.X, explicitPosition.Y)
                : automatic.TryGetValue(item.node.Id, out var computed)
                    ? computed
                    : (OriginX + (item.index % 6) * (NodeWidth + ColumnGap), OriginY + (item.index / 6) * (NodeHeight + RowGap));

            while (display.Values.Any(existing => Overlaps(position, existing)))
            {
                position = (position.X, position.Y + NodeHeight + RowGap);
            }

            display[item.node.Id] = position;
        }

        return display;
    }

    private static bool Overlaps((double X, double Y) first, (double X, double Y) second) =>
        first.X < second.X + NodeWidth &&
        second.X < first.X + NodeWidth &&
        first.Y < second.Y + NodeHeight &&
        second.Y < first.Y + NodeHeight;

    /// <summary>
    /// graph.yaml に layout が無いノードの座標を、edges の到達順 (トポロジカル順) から自動計算する。
    /// これにより layout セクションは任意のままにできる (座標を手で書かなくてもきれいに並ぶ)。
    /// loopBack エッジは後退辺なので、段組みの計算からは除外する。
    /// </summary>
    private static Dictionary<string, (double X, double Y)> ComputeAutoLayout(GraphDefinition graph)
    {
        var nodeIds = graph.Nodes.Select(node => node.Id).ToArray();
        var forwardEdges = graph.Edges.Where(edge => !edge.LoopBack).ToArray();
        var outgoing = forwardEdges
            .GroupBy(edge => edge.From, StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.Select(edge => edge.To).ToArray(), StringComparer.Ordinal);
        var incoming = forwardEdges
            .GroupBy(edge => edge.To, StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.Select(edge => edge.From).ToArray(), StringComparer.Ordinal);

        var inDegree = nodeIds.ToDictionary(id => id, _ => 0, StringComparer.Ordinal);
        foreach (var edge in forwardEdges)
        {
            if (inDegree.ContainsKey(edge.To))
            {
                inDegree[edge.To]++;
            }
        }

        var rank = nodeIds.ToDictionary(id => id, _ => 0, StringComparer.Ordinal);
        var remaining = new Dictionary<string, int>(inDegree, StringComparer.Ordinal);
        var queue = new Queue<string>(nodeIds.Where(id => inDegree[id] == 0));
        while (queue.Count > 0)
        {
            var id = queue.Dequeue();
            if (!outgoing.TryGetValue(id, out var targets))
            {
                continue;
            }
            foreach (var target in targets)
            {
                if (!remaining.ContainsKey(target))
                {
                    continue;
                }
                rank[target] = Math.Max(rank[target], rank[id] + 1);
                if (--remaining[target] == 0)
                {
                    queue.Enqueue(target);
                }
            }
        }

        // 各列 (rank) 内でのノードの並び順。初期値は定義順。
        var columns = nodeIds
            .Select((id, index) => (id, index))
            .GroupBy(item => rank[item.id])
            .OrderBy(group => group.Key)
            .ToDictionary(group => group.Key, group => group.OrderBy(item => item.index).Select(item => item.id).ToList());

        ReduceCrossings(columns, incoming, outgoing);

        var layout = new Dictionary<string, (double X, double Y)>(StringComparer.Ordinal);
        foreach (var column in columns)
        {
            for (var row = 0; row < column.Value.Count; row++)
            {
                layout[column.Value[row]] = (OriginX + column.Key * (NodeWidth + ColumnGap), OriginY + row * (NodeHeight + RowGap));
            }
        }
        return layout;
    }

    /// <summary>
    /// Sugiyama 法の重心 (barycenter) ヒューリスティックで、列内のノード順を隣接列とのエッジ交差が少なくなるように並べ替える。
    /// 前方 (親の位置基準) と後方 (子の位置基準) を交互に数回スイープし、各ノードを隣接列の平均位置に近づける。
    /// </summary>
    private static void ReduceCrossings(
        Dictionary<int, List<string>> columns,
        Dictionary<string, string[]> incoming,
        Dictionary<string, string[]> outgoing)
    {
        if (columns.Count < 2)
        {
            return;
        }

        var order = new Dictionary<string, int>(StringComparer.Ordinal);
        void ReindexColumn(int key)
        {
            var column = columns[key];
            for (var i = 0; i < column.Count; i++)
            {
                order[column[i]] = i;
            }
        }
        foreach (var key in columns.Keys)
        {
            ReindexColumn(key);
        }

        double Barycenter(string nodeId, Dictionary<string, string[]> neighborMap)
        {
            if (!neighborMap.TryGetValue(nodeId, out var neighbors) || neighbors.Length == 0)
            {
                return order[nodeId];
            }
            var known = neighbors.Where(order.ContainsKey).ToArray();
            return known.Length == 0 ? order[nodeId] : known.Average(id => order[id]);
        }

        var ascending = columns.Keys.OrderBy(key => key).ToArray();
        var descending = columns.Keys.OrderByDescending(key => key).ToArray();

        for (var sweep = 0; sweep < 4; sweep++)
        {
            var forward = sweep % 2 == 0;
            var neighborMap = forward ? incoming : outgoing;
            foreach (var key in forward ? ascending : descending)
            {
                var column = columns[key];
                var reordered = column
                    .Select(id => (id, score: Barycenter(id, neighborMap)))
                    .OrderBy(item => item.score)
                    .Select(item => item.id)
                    .ToList();
                columns[key] = reordered;
                ReindexColumn(key);
            }
        }
    }

    private static string NodeMeta(GraphNode node) => node.Kind switch
    {
        NodeKind.Agent => node.Agent ?? "agent",
        NodeKind.Team => node.Team ?? "team",
        NodeKind.Loop => $"max {node.Stop?.MaxIterations ?? 10}",
        NodeKind.Approval => "human in the loop",
        _ => node.Summary ?? node.Kind.ToString().ToLowerInvariant(),
    };

    private static string? Text(double? value)
        => value?.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private static int? ParseInt(string? value)
        => int.TryParse(value, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var result)
            ? result
            : null;

    private static double? ParseDouble(string? value)
        => double.TryParse(value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var result)
            ? result
            : null;
}
