    /// <summary>キャンバス上でノードをドラッグして接続したときに JS から呼ばれる。</summary>
    [JSInvokable]
    public void OnEdgeDropped(string fromId, string toId)
    {
        if (string.IsNullOrWhiteSpace(fromId) || string.IsNullOrWhiteSpace(toId) || fromId == toId)
        {
            return;
        }
        if (nodes.All(node => node.Id != fromId) || nodes.All(node => node.Id != toId))
        {
            return;
        }
        if (edges.Any(edge => edge.From == fromId && edge.To == toId))
        {
            return;
        }
        var created = new GraphEdge { Id = UniqueEdgeId(fromId, toId), From = fromId, To = toId };
        edges.Add(created);
        selectedEdgeId = created.Id;
        inspectorTab = "edges";
        MarkDirty();
        StateHasChanged();
    }

