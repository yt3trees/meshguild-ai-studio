@page "/secrets"
@using WorkAgents.Core.Abstractions
@inject ISecretStore SecretStore

<PageTitle>MeshGuild AI Studio | Secrets</PageTitle>

<section class="secrets-page">
    <header class="secrets-header">
        <div>
            <span class="section-kicker">Runtime</span>
            <h1>Stored secrets</h1>
            <p>ISecretStoreに保存済みの秘密の名前一覧です。値は表示されません。不要になった秘密はここから削除できます。</p>
        </div>
        <button type="button" class="secondary-button" @onclick="ReloadAsync" disabled="@IsBusy">↻ Refresh</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="notice @(IsError ? "error" : "success")" role="status">@Message</div>
    }

    <div class="secrets-list" aria-label="保存済みの秘密">
        @if (SecretNames.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-mark" aria-hidden="true">S</span>
                <h2>No secrets stored</h2>
                <p>APIキーやクライアントシークレットはModels画面から登録されます。</p>
            </div>
        }
        else
        {
            @foreach (var name in SecretNames)
            {
                <article class="secret-row">
                    <code>@name</code>
                    <button type="button" class="icon-button danger" title="この秘密を削除" @onclick="() => DeleteAsync(name)">×</button>
                </article>
            }
        }
    </div>
</section>

@code {
    private IReadOnlyList<string> SecretNames = Array.Empty<string>();
    private bool IsBusy;
    private bool IsError;
    private string? Message;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        IsBusy = true;
        try
        {
            SecretNames = await SecretStore.ListAsync();
        }
        catch (Exception ex)
        {
            IsError = true;
            Message = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task DeleteAsync(string name)
    {
        try
        {
            var deleted = await SecretStore.DeleteAsync(name);
            IsError = !deleted;
            Message = deleted ? $"Deleted '{name}'." : $"'{name}' was already gone.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            IsError = true;
            Message = ex.Message;
        }
    }
}
