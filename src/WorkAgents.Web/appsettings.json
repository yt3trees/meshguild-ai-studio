{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Profile": "Local",
  "OTEL_CONSOLE_DISABLED": false,
  "Orchestration": {
    "HostBaseUrl": "http://localhost:5160",
    "Engine": {
      "Enabled": false
    },
    "Limits": {
      "MaxConcurrentMissions": 5,
      "MaxConcurrentAgents": 12,
      "AskTimeoutSeconds": 300
    },
    "Checkpoint": {
      "MaxWorkspaceBytes": 536870912
    },
    "Triggers": {
      "Webhook": {
        "Loopback": true
      }
    }
  }
}